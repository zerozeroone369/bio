# ========================================================
# BIO LINK - CẤU HÌNH BIẾN MÔI TRƯỜNG HỆ THỐNG
# ========================================================

# Cổng khởi chạy máy chủ (Render tự động cấp PORT)
PORT=3000

# --------------------------------------------------------
# CẤU HÌNH GỬI EMAIL XÁC THỰC OTP QUA GMAIL
# --------------------------------------------------------
# Hướng dẫn tạo Mật khẩu ứng dụng Gmail (App Password):
# 1. Truy cập tài khoản Google: https://myaccount.google.com/apppasswords
# 2. Bật "Xác minh 2 bước" (2-Step Verification) nếu chưa bật
# 3. Tạo mật khẩu ứng dụng mới đặt tên "Bio Link", Google sẽ cấp 16 ký tự (ví dụ: abcd efgh ijkl mnop)
# 4. Điền địa chỉ Gmail vào SMTP_USER và 16 ký tự đó vào SMTP_PASS bên dưới:
SMTP_USER=your_email@gmail.com
SMTP_PASS=abcdefghijklmnop

# (Tùy chọn) Máy chủ SMTP khác nếu không dùng Gmail mặc định:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# --------------------------------------------------------
# CẤU HÌNH CƠ SỞ DỮ LIỆU MONGODB ATLAS (LƯU TRỮ VĨNH VIỄN)
# --------------------------------------------------------
# Nếu chạy trên Render hoặc Production, điền MongoDB URI để dữ liệu tài khoản
# và mật khẩu không bị reset khi khởi động lại máy chủ:
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/bio_link_db?retryWrites=true&w=majority
# MONGODB_DB_NAME=bio_link_db
